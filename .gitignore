# =====================================================================
# CreditMaster — what does NOT go into git
# Rule of thumb: code, docs and small configs are versioned;
# raw data, training artifacts and regenerable outputs are not.
# =====================================================================

# --- Data (large or regenerable) ------------------------------------
*.csv
*.zip
*.tar.gz
*.jsonl
# Raw LendingClub data (~1.6 GB) — download from Kaggle
Dataset/accepted_2007_to_2018Q4.csv
# v2 dataset produced by build_dataset.py (deterministic, seed 42).
# manifest.json stays versioned to record the configuration used.
Dataset/rag_v2/*.jsonl
Dataset/rag_v2/*.csv
# Portuguese translation of the policy, kept locally only
credit_policy_pt.md

# --- Model weights and checkpoints ----------------------------------
lora_model/
model_gguf/
model_gguf_gguf/
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# --- Generated outputs (regenerable) --------------------------------
outputs/
charts/
# Modelfiles are generated by training and contain local paths
ollama/Modelfile.*

# Exception: v1 training metrics (small historical record used in the thesis)
!legacy_v1/outputs/
!legacy_v1/outputs/training_metrics.csv
!legacy_v1/outputs/training_summary.json

# --- Logs -------------------------------------------------------------
*.log
!legacy_v1/outputs/training.log

# --- Python -----------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
unsloth_compiled_cache/
.venv/
venv/
env/
ENV/

# --- ML caches / notebooks -------------------------------------------
.cache/
wandb/
.ipynb_checkpoints/

# --- IDEs, Claude Code and OS files ----------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json
Thumbs.db
Desktop.ini
.DS_Store
